#!/usr/bin/env bash
set -euo pipefail

# Pre-push hook
# Runs the fast checks for the layers the pushed commits touch
# (scripts/scoped-checks.sh). Tests, coverage, the build and E2E are CI's job
# on the pull request, and `just merge` refuses until they are green; the hook
# only catches what a commit slipped past. `just harness` runs CI's gate locally.

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# Colors (respect NO_COLOR=1)
if [ -n "${NO_COLOR:-}" ]; then
    RED='' YELLOW='' GREEN='' BLUE='' NC=''
else
    RED='\033[0;31m'
    YELLOW='\033[0;33m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    NC='\033[0m'
fi

# Git provides "<local-ref> <local-sha> <remote-ref> <remote-sha>" on stdin per
# ref (see `man githooks`). A deletion has an all-zero local sha (40 hex under
# SHA-1, 64 under SHA-256); a new remote ref has an all-zero remote sha. Drain
# all of stdin so every ref is seen; `while read` at EOF returns non-zero, which
# bash treats as the loop terminator, not an errexit.
DELETE_ONLY=true
HAS_REFS=false
CHANGED=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    HAS_REFS=true
    if [[ "$local_sha" =~ ^0+$ ]]; then
        continue
    fi
    DELETE_ONLY=false
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        # New branch: everything since it left main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git merge-base "$local_sha" main 2>/dev/null || echo "")
    else
        base="$remote_sha"
    fi
    if [[ -n "$base" ]]; then
        CHANGED+=$(git diff --name-only --diff-filter=ACMRD "$base" "$local_sha" || true)$'\n'
    else
        echo -e "${YELLOW}⚠  No merge base with main found — only the tip commit is scoped.${NC}"
        CHANGED+=$(git diff-tree --no-commit-id --name-only -r "$local_sha" || true)$'\n'
    fi
done

if [[ "$HAS_REFS" == true && "$DELETE_ONLY" == true ]]; then
    echo -e "${BLUE}ℹ  Delete-only push — skipping quality check.${NC}"
    exit 0
fi

if printf '%s' "$CHANGED" | bash "$PROJECT_ROOT/scripts/scoped-checks.sh"; then
    echo -e "${GREEN}✅ Checks passed. Pushing.${NC}"
else
    echo -e "${RED}❌ Push blocked! One or more checks failed.${NC}"
    exit 1
fi
