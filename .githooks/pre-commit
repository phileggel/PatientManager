#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook
# Blocks commits to main, patient data (privacy-check.py), and runs the fast
# checks for the layers the staged files touch. Blocks the commit on failure.

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# Colors (respect NO_COLOR=1)
if [ -n "${NO_COLOR:-}" ]; then
    RED='' GREEN='' BLUE='' NC=''
else
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    NC='\033[0m'
fi

# Block direct commits to main
CURRENT_BRANCH=$(git branch --show-current)
if [ "$CURRENT_BRANCH" = "main" ]; then
    echo -e "${RED}❌ Direct commits to main are not allowed.${NC}"
    echo -e "${BLUE}   Create a feature branch: git checkout -b feat/your-feature${NC}"
    echo -e "${BLUE}   To bypass (emergencies only): git commit --no-verify${NC}"
    exit 1
fi

# Patient data (SSN, IBAN, names in logs, real data files) never enters the repository.
if ! python3 "$PROJECT_ROOT/scripts/privacy-check.py" --staged; then
    echo -e "${RED}❌ Privacy check failed. Commit blocked.${NC}"
    exit 1
fi

# Fast checks for the layers the staged files touch (scripts/scoped-checks.sh).
if git diff --cached --name-only --diff-filter=ACMRD | bash "$PROJECT_ROOT/scripts/scoped-checks.sh"; then
    echo -e "${GREEN}✨ Checks passed. Commit allowed.${NC}"
else
    echo -e "${RED}❌ Commit blocked.${NC}"
    exit 1
fi
