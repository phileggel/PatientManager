  "query": "\n            SELECT id, patient_id, fund_id, procedure_type_id, procedure_date, billed_amount, payment_method, fund_reconciliation_date, confirmed_payment_date, paid_amount, payment_status, is_deleted\n            FROM procedure\n            WHERE patient_id = $1\n              AND fund_id IS $2\n              AND procedure_date = $3\n              AND billed_amount = $4\n              AND is_deleted = 0\n            LIMIT 1\n            ",
